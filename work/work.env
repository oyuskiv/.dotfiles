alias mc="mc -x"

alias gcrlogin="gcloud auth print-access-token | docker login -u oauth2accesstoken --password-stdin eu.gcr.io"
alias artlogin="docker login artifactory.dentsplysirona.com"

export DSCORE_HOME=$XDG_CONFIG_HOME/dscore

function diask() {
    make skaffold-dev TARGET="$1" ALIAS=diqhe695 DEV_ENV=gcp
}

function diaalisk() {
    make skaffold-dev TARGET="$1" ALIAS=diqhe695 DEV_ENV=alicloud
}

function diagcpskd() {
    make skaffold-debug TARGET="$1" ALIAS=diqhe695 DEV_ENV=gcp
}

function diaaliskd() {
    make skaffold-debug TARGET="$1" ALIAS=diqhe695 DEV_ENV=alicloud
}

function ligsk() {
    dscore skaffold "$1" -a diqhe695 -c lightning-d2 -n core
}

function dscorejwt(){
    dscore auth jwt -f "$DSCORE_HOME/account" > /dev/null 2>&1
    DSCORE_USER_JWT_TOKEN=$(pbpaste)
    export DSCORE_USER_JWT_TOKEN
}

function taskenv(){
    # 1. Validation: Ensure a task ID was provided
    if [ -z "$1" ]; then
        echo "✘ Error: Missing task_id argument."
        echo "Usage: taskenv <task_id>"
        return 1
    fi

    # Branch name is the argument as-is; directory name is the part after the last '/'
    #   feat/some-task -> branch "feat/some-task", dir "some-task"
    #   some-task      -> branch "some-task",      dir "some-task"
    local BRANCH="$1"
    local DIR_NAME="${1##*/}"
    if [ -z "$DIR_NAME" ]; then
        echo "✘ Error: Could not derive a directory name from '$1'."
        return 1
    fi

    # Resolve the repo root so this works from any directory inside the repo
    local REPO_ROOT
    if ! REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo "✘ Error: Not inside a git repository."
        return 1
    fi

    # Place the new worktree as a sibling of the repo root
    local WORKTREE_PATH="$(dirname "$REPO_ROOT")/$DIR_NAME"

    # 2. Create the git worktree (using '|| return 1' to abort if git fails)
    echo "𖣂 Creating git worktree in $WORKTREE_PATH (branch $BRANCH)..."
    if ! git worktree add "$WORKTREE_PATH" -b "$BRANCH" origin/main; then
        echo "✘ Error: Git worktree creation failed."
        return 1
    fi

    # 2b. Symlink cspell.json from the repo root if present and not already checked out
    if [ -f "$REPO_ROOT/cspell.json" ] && [ ! -e "$WORKTREE_PATH/cspell.json" ]; then
        ln -s "../$(basename "$REPO_ROOT")/cspell.json" "$WORKTREE_PATH/cspell.json"
        echo "☍ Linked cspell.json from $(basename "$REPO_ROOT")."
    fi

    # 3. Create the tmux session
    echo "⚡ Creating tmux session '$DIR_NAME'..."

    # Create the session detached (-d), starting with the 'vim' window
    tmux new-session -d -s "$DIR_NAME" -n "vim" -c "$WORKTREE_PATH"

    # Create the other 3 windows in the same worktree directory
    tmux new-window -t "$DIR_NAME" -n "zsh" -c "$WORKTREE_PATH"
    tmux new-window -t "$DIR_NAME" -n "git" -c "$WORKTREE_PATH"
    tmux new-window -t "$DIR_NAME" -n "claude" -c "$WORKTREE_PATH"

    # Focus back on the first window (vim)
    tmux select-window -t "$DIR_NAME:vim"

    # 4. Attach to the session
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$DIR_NAME"
    else
        tmux attach-session -t "$DIR_NAME"
    fi
}
